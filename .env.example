# ============================================================
# EcoHome API — Variables de entorno necesarias en producción
# Copiar este archivo a .env para desarrollo local.
# NUNCA commitear .env con valores reales.
# ============================================================

# ── Perfil ────────────────────────────────────────────────────
# "prod" activa validaciones fail-fast: la API no arranca si JWT_SECRET
# o DB_PASSWORD siguen teniendo el valor de desarrollo. Dejar vacío/"dev" en local.
SPRING_PROFILES_ACTIVE=prod

# ── Base de datos ─────────────────────────────────────────────
# En Railway: usar los valores que da el plugin MySQL (ver instrucciones)
DB_URL=jdbc:mysql://HOST:3306/NOMBRE_BD?useSSL=true&serverTimezone=Europe/Madrid&allowPublicKeyRetrieval=true
DB_USER=usuario_mysql
DB_PASSWORD=password_mysql

# ── JWT ───────────────────────────────────────────────────────
# Generar con: openssl rand -hex 32  (mínimo 32 chars para HS256)
JWT_SECRET=CAMBIAR_POR_SECRETO_SEGURO_64_CARACTERES_ALEATORIOS
JWT_EXPIRATION_MS=3600000

# ── MQTT (opcional — sin broker el sistema funciona sin IoT) ──
# En producción usar SIEMPRE ssl://broker:8883, nunca tcp:// hacia un host
# remoto. HiveMQ Cloud (plan gratuito) da un broker con TLS ya configurado:
# 1. Crear cluster gratuito en https://www.hivemq.com/mqtt-cloud-broker/
# 2. Copiar el host (termina en .hivemq.cloud) y crear credenciales
# 3. MQTT_BROKER=ssl://TU-CLUSTER.hivemq.cloud:8883
MQTT_BROKER=tcp://localhost:1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_ENABLED=false

# ── CORS ──────────────────────────────────────────────────────
# URL del frontend web (si solo usas JavaFX, deja el valor por defecto)
CORS_ORIGINS=http://localhost:3000
